// ════════════════════════════════════════════════════════════════════
//  AIP TERRAIN — Schéma Prisma
//
//  Workflow de validation à 2 niveaux (systématique) :
//    Commercial → Superviseur (niv.1) → Coordinateur (niv.2) → Validé
//
//  4 rôles : ADMIN, COORDINATEUR, SUPERVISEUR, COMMERCIAL
//
//  Organisation géographique :
//    COUCHE RÉFÉRENCE (figée, seed) : Commune → Quartier
//    COUCHE OPÉRATIONNELLE (admin) : Zone → Secteur
//
//    Zone (1 coordinateur) → Secteur (1 superviseur) → Commerciaux
//    Zone regroupe des Communes, Secteur regroupe des Quartiers
// ════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ════════════════════════════════════════════════════════════════════
//  ENUMS
// ════════════════════════════════════════════════════════════════════

/// Les 4 rôles de la plateforme.
enum Role {
  ADMIN // Pilotage global AIP
  COORDINATEUR // Validation niveau 2, pilotage de zone
  SUPERVISEUR // Validation niveau 1
  COMMERCIAL // Collecte terrain
  CLIENT // Lecture seule : KPIs + enregistrements validés (ex: MANSA BANK)
}

/// Type de soumission terrain.
enum SubmissionType {
  PROSPECT // Recrutement d'un utilisateur final (client banque)
  MARCHAND // Enrôlement d'un commerce partenaire
}

/// États du workflow de validation à 2 niveaux.
///   DRAFT → SUBMITTED → SUPERVISOR_APPROVED → VALIDATED
///   (rejet possible à chaque niveau : REJECTED_L1 / REJECTED_L2)
enum SubmissionStatus {
  DRAFT // Brouillon local, jamais soumis
  SUBMITTED // Soumis, en attente de validation niveau 1 (superviseur)
  SUPERVISOR_APPROVED // Validé niveau 1, en attente niveau 2 (coordinateur)
  VALIDATED // Validé niveau 2 — validation finale
  REJECTED_L1 // Rejeté par le superviseur (niveau 1)
  REJECTED_L2 // Rejeté par le coordinateur (niveau 2)
}

/// Statut d'installation de l'application bancaire (donnée digitale du prospect).
enum AppStatus {
  INSTALLED // Application installée
  INSTALLED_ACTIVATED // Application installée et activée
}

/// Statut de synchronisation d'une soumission créée offline.
enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

/// Statut de l'agent (cycle de vie du compte).
/// Conforme au document K2L Profils — Fiche (IV).
enum AgentStatus {
  ACTIF // Opérationnel, autorisé à utiliser l'application
  SUSPENDU // Temporairement bloqué (disciplinaire, absence, fraude suspectée)
  EN_ATTENTE // Pas encore validé (dossier en cours, formation non terminée)
  DESACTIVE // Compte fermé définitivement (fin de mission, démission)
}

/// Catégorie de photo preuve rattachée à une soumission.
enum PhotoCategory {
  APP_SCREEN // Écran avec l'app installée (prospect)
  ID_DOCUMENT // CNI du client/propriétaire
  STOREFRONT // Façade du commerce (marchand)
  QR_CODE // QR code du marchand installé
}

/// Type d'action dans l'historique de validation (traçabilité / audit).
enum ValidationAction {
  SUBMITTED // Soumission initiale par le commercial
  SUPERVISOR_APPROVED // Validation niveau 1 par le superviseur
  VALIDATED // Validation niveau 2 (finale) par le coordinateur
  REJECTED_L1 // Rejet niveau 1
  REJECTED_L2 // Rejet niveau 2
  RETURNED // Renvoyé pour correction
}

// ════════════════════════════════════════════════════════════════════
//  COUCHE RÉFÉRENCE — Commune & Quartier (figées, préchargées via seed)
// ════════════════════════════════════════════════════════════════════

/// Commune d'Abidjan (ex: Yopougon, Cocody, Marcory…).
/// Peut être affectée à UNE zone (zoneId nullable = non affectée).
model Commune {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  // ── Affectation à une zone (nullable = non encore affectée) ──
  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  // ── Relations ──
  quartiers   Quartier[]
  submissions Submission[] @relation("SubmissionCommune")

  @@index([zoneId])
  @@map("communes")
}

/// Quartier rattaché à UNE commune (référence figée).
/// Peut être affecté à UN secteur (secteurId nullable = disponible).
model Quartier {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  // ── Commune parente (fixe) ──
  communeId String
  commune   Commune @relation(fields: [communeId], references: [id], onDelete: Restrict)

  // ── Affectation à un secteur (nullable = disponible) ──
  secteurId String?
  secteur   Secteur? @relation(fields: [secteurId], references: [id], onDelete: SetNull)

  // ── Relations ──
  submissions Submission[] @relation("SubmissionQuartier")

  @@unique([name, communeId])
  @@index([communeId])
  @@index([secteurId])
  @@map("quartiers")
}

// ════════════════════════════════════════════════════════════════════
//  COUCHE OPÉRATIONNELLE — Zone & Secteur
// ════════════════════════════════════════════════════════════════════

/// Zone définie librement par l'admin (ex: "Zone Sud", "Zone Abidjan-Est").
/// Regroupe des communes. Pilotée par UN coordinateur.
model Zone {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Coordinateur de la zone (relation 1-à-1) ──
  coordinatorId String? @unique
  coordinator   User?   @relation("ZoneCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)

  // ── Membres rattachés à la zone ──
  members User[] @relation("ZoneMembers")

  // ── Communes affectées à cette zone ──
  communes Commune[]

  // ── Secteurs de cette zone ──
  secteurs Secteur[]

  @@index([isActive])
  @@map("zones")
}

/// Secteur opérationnel : regroupe des quartiers, appartient à UNE zone.
/// Dirigé par UN superviseur (relation 1-à-1).
model Secteur {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Zone parente ──
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  // ── Superviseur du secteur (relation 1-à-1) ──
  supervisorId String? @unique
  supervisor   User?   @relation("SecteurSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  // ── Quartiers affectés à ce secteur ──
  quartiers Quartier[]

  // ── Commerciaux rattachés à ce secteur ──
  members User[] @relation("SecteurMembers")

  // ── Soumissions dénormalisées ──
  submissions Submission[] @relation("SubmissionSecteur")

  @@unique([name, zoneId])
  @@index([zoneId])
  @@index([isActive])
  @@map("secteurs")
}

// ════════════════════════════════════════════════════════════════════
//  UTILISATEURS & AUTHENTIFICATION
// ════════════════════════════════════════════════════════════════════

/// Compte utilisateur — couvre les 4 rôles.
///
/// Rattachements :
///   - Un COORDINATEUR pilote UNE zone (via ZoneCoordinator)
///   - Un SUPERVISEUR pilote UN secteur (via SecteurSupervisor) et appartient à une zone
///   - Un COMMERCIAL appartient à un secteur (secteurId) et à un superviseur (supervisorId)
model User {
  id        String      @id @default(uuid())
  matricule String      @unique
  fullName  String
  email     String?     @unique
  phone     String      @unique
  password  String // hash bcrypt
  role      Role
  status    AgentStatus @default(ACTIF)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // ── Rattachement à une zone (superviseurs et commerciaux) ──
  zoneId String?
  zone   Zone?   @relation("ZoneMembers", fields: [zoneId], references: [id], onDelete: SetNull)

  // ── Zone pilotée (uniquement pour le coordinateur) ──
  coordinatedZone Zone? @relation("ZoneCoordinator")

  // ── Secteur piloté (uniquement pour le superviseur, relation 1-à-1) ──
  supervisedSecteur Secteur? @relation("SecteurSupervisor")

  // ── Rattachement à un secteur (pour les commerciaux) ──
  secteurId String?
  secteur   Secteur? @relation("SecteurMembers", fields: [secteurId], references: [id], onDelete: SetNull)

  // ── Hiérarchie commercial ↔ superviseur ──
  supervisorId String?
  supervisor   User?   @relation("SupervisorToCommercials", fields: [supervisorId], references: [id], onDelete: SetNull)
  commercials  User[]  @relation("SupervisorToCommercials")

  // ── Relations métier ──
  submissions       Submission[]        @relation("CommercialSubmissions")
  level1Validations Submission[]        @relation("Level1Validator")
  level2Validations Submission[]        @relation("Level2Validator")
  validationHistory ValidationHistory[]
  refreshTokens     RefreshToken[]

  @@index([role])
  @@index([zoneId])
  @@index([secteurId])
  @@index([supervisorId])
  @@index([isActive])
  @@index([status])
  @@map("users")
}

/// Refresh tokens pour l'auth JWT.
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ════════════════════════════════════════════════════════════════════
//  SOUMISSIONS (prospects + marchands)
// ════════════════════════════════════════════════════════════════════

/// Soumission terrain unifiée : un PROSPECT ou un MARCHAND.
model Submission {
  id     String           @id @default(uuid())
  type   SubmissionType
  status SubmissionStatus @default(DRAFT)

  // ── Auteur (commercial) ──
  commercialId String
  commercial   User   @relation("CommercialSubmissions", fields: [commercialId], references: [id], onDelete: Restrict)

  // ── Dénormalisation géographique (recopiés à la création pour KPIs) ──
  zoneId     String?
  secteurId  String?
  communeId  String?
  quartierId String?

  // ── Relations géographiques (FK) ──
  secteurRef  Secteur?  @relation("SubmissionSecteur", fields: [secteurId], references: [id], onDelete: SetNull)
  communeRef  Commune?  @relation("SubmissionCommune", fields: [communeId], references: [id], onDelete: SetNull)
  quartierRef Quartier? @relation("SubmissionQuartier", fields: [quartierId], references: [id], onDelete: SetNull)

  // ── Géolocalisation ──
  latitude      Float?
  longitude     Float?
  gpsAccuracy   Float?
  gpsCapturedAt DateTime?
  commune       String
  quartier      String?
  addressNote   String?

  // ── Champs PROSPECT ──
  prospectFullName   String?
  prospectPhone      String?
  prospectProfession String?
  prospectGender     String?
  prospectAge        Int?
  appStatus          AppStatus?
  phoneType          String?
  bankAccount        String?
  observations       String?

  // ── Champs MARCHAND ──
  merchantName     String?
  merchantOwner    String?
  merchantPhone    String?
  merchantActivity String?
  merchantRccm     String?

  // ── Synchronisation offline ──
  clientUuid     String     @unique
  syncStatus     SyncStatus @default(SYNCED)
  createdOffline Boolean    @default(false)

  // ── Validation NIVEAU 1 (superviseur) ──
  level1ValidatorId String?
  level1Validator   User?     @relation("Level1Validator", fields: [level1ValidatorId], references: [id], onDelete: SetNull)
  level1At          DateTime?
  level1Comment     String?

  // ── Validation NIVEAU 2 (coordinateur) ──
  level2ValidatorId String?
  level2Validator   User?     @relation("Level2Validator", fields: [level2ValidatorId], references: [id], onDelete: SetNull)
  level2At          DateTime?
  level2Comment     String?

  // ── Timestamps ──
  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt

  // ── Relations ──
  photos            Photo[]
  validationHistory ValidationHistory[]

  // ── Index ──
  @@index([commercialId])
  @@index([zoneId])
  @@index([secteurId])
  @@index([communeId])
  @@index([quartierId])
  @@index([status])
  @@index([type])
  @@index([commune])
  @@index([createdAt])
  @@index([prospectPhone])
  @@index([status, type])
  @@index([level1ValidatorId])
  @@index([level2ValidatorId])
  @@map("submissions")
}

// ════════════════════════════════════════════════════════════════════
//  PHOTOS PREUVES (métadonnées Cloudinary uniquement)
// ════════════════════════════════════════════════════════════════════

model Photo {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  cloudinaryPublicId String
  url                String
  category           PhotoCategory?
  width              Int?
  height             Int?
  bytes              Int?
  createdAt          DateTime       @default(now())

  @@index([submissionId])
  @@map("photos")
}

// ════════════════════════════════════════════════════════════════════
//  HISTORIQUE DE VALIDATION (traçabilité / audit / litiges client)
// ════════════════════════════════════════════════════════════════════

model ValidationHistory {
  id           String           @id @default(uuid())
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action       ValidationAction
  comment      String?
  createdAt    DateTime         @default(now())

  @@index([submissionId])
  @@index([actorId])
  @@map("validation_history")
}
