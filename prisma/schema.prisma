// ════════════════════════════════════════════════════════════════════
//  K2L TERRAIN — Schéma Prisma (refonte Cluster)
//
//  Hiérarchie à 3 niveaux :
//    COORDINATEUR  (valide TOUTES les soumissions)
//      └── SUPERVISEUR  (1 par cluster, gère ses commerciaux)
//            └── COMMERCIAL  (rattaché à 1 superviseur = 1 cluster)
//
//  Workflow validation à 1 seul niveau :
//    DRAFT → SUBMITTED → VALIDATED (ou REJECTED)
//
//  Organisation géographique :
//    COUCHE RÉFÉRENCE (figée, seed) : Commune → Quartier
//    COUCHE OPÉRATIONNELLE (admin) : Cluster (regroupe des communes)
//
//  Règles clés :
//    - Une commune appartient à UN seul cluster
//    - Un cluster est dirigé par UN superviseur (relation 1-à-1)
//    - La table Quartier est conservée pour usage futur (KPIs)
//      mais le commercial saisit son quartier en texte libre dans la soumission
// ════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ════════════════════════════════════════════════════════════════════
//  ENUMS
// ════════════════════════════════════════════════════════════════════

enum Role {
  ADMIN
  COORDINATEUR
  SUPERVISEUR
  COMMERCIAL
  CLIENT
}

enum SubmissionType {
  PROSPECT
  MARCHAND
}

/// Workflow simplifié à 1 seul niveau de validation.
enum SubmissionStatus {
  DRAFT     // Brouillon local, jamais soumis
  SUBMITTED // Soumis, en attente de validation par le coordinateur
  VALIDATED // Validé par le coordinateur — validation finale
  REJECTED  // Rejeté par le coordinateur
}

enum AppStatus {
  NOT_INSTALLED
  INSTALLED
  INSTALLED_TRANSACTIONS
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum AgentStatus {
  ACTIF
  SUSPENDU
  EN_ATTENTE
  DESACTIVE
}

/// Catégories de photos UNIQUEMENT pour les marchands.
/// Les prospects n'ont plus de photos.
enum PhotoCategory {
  STOREFRONT
  QR_CODE
  ID_DOCUMENT
}

enum ValidationAction {
  SUBMITTED
  VALIDATED
  REJECTED
  RESUBMITTED // Re-soumission après rejet
}

// ════════════════════════════════════════════════════════════════════
//  COUCHE RÉFÉRENCE — Commune & Quartier (figées, préchargées via seed)
// ════════════════════════════════════════════════════════════════════

/// Commune d'Abidjan (ex: Yopougon, Cocody, Marcory…).
/// Une commune appartient à UN SEUL cluster (clusterId nullable = non affectée).
model Commune {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  // Affectation à un cluster
  clusterId String?
  cluster   Cluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  quartiers   Quartier[]
  submissions Submission[] @relation("SubmissionCommune")

  @@index([clusterId])
  @@map("communes")
}

/// Quartier rattaché à UNE commune (référence figée).
/// Conservé pour usage futur (analyses KPIs par quartier).
/// Le commercial saisit son quartier en TEXTE LIBRE dans la soumission.
model Quartier {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  communeId String
  commune   Commune @relation(fields: [communeId], references: [id], onDelete: Restrict)

  @@unique([name, communeId])
  @@index([communeId])
  @@map("quartiers")
}

// ════════════════════════════════════════════════════════════════════
//  COUCHE OPÉRATIONNELLE — Cluster
// ════════════════════════════════════════════════════════════════════

/// Cluster défini librement par l'admin (ex: "Cluster Sud", "Cluster Abidjan-Est").
/// Regroupe une ou plusieurs communes. Dirigé par UN superviseur (1-à-1).
model Cluster {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Superviseur du cluster (1-à-1, nullable si pas encore assigné)
  supervisorId String? @unique
  supervisor   User?   @relation("ClusterSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  // Membres rattachés au cluster (le superviseur + ses commerciaux)
  members User[] @relation("ClusterMembers")

  // Communes affectées à ce cluster
  communes Commune[]

  @@index([isActive])
  @@map("clusters")
}

// ════════════════════════════════════════════════════════════════════
//  UTILISATEURS & AUTHENTIFICATION
// ════════════════════════════════════════════════════════════════════

/// Compte utilisateur — couvre les 5 rôles.
///
/// Rattachements selon le rôle :
///   ADMIN        : aucun rattachement territorial
///   COORDINATEUR : aucun rattachement territorial (voit tout pour valider)
///   SUPERVISEUR  : dirige UN cluster (via Cluster.supervisorId)
///                  + appartient au cluster (clusterId, pour cohérence des filtres)
///   COMMERCIAL   : appartient à UN superviseur (supervisorId)
///                  + hérite du clusterId du superviseur (dénormalisé pour KPIs)
///   CLIENT       : aucun rattachement (lecture seule)
model User {
  id          String      @id @default(uuid())
  matricule   String      @unique
  fullName    String
  gender      String?     // Genre: "M" (Masculin), "F" (Féminin)
  email       String?     @unique
  phone       String      @unique
  password    String
  role        Role
  status      AgentStatus @default(ACTIF)
  isActive    Boolean     @default(true)
  sponsorCode String?     @unique // Code de parrainage unique (traçabilité des recrutements)
  objectifQuotidien Int     @default(20) // Objectif quotidien de soumissions (prospects + marchands)
  commune     String?             // Commune principale (ex: Abobo, Yopougon)
  habitation  String?             // Adresse d'habitation (informatif)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?   // Soft-delete: si renseigné, le compte est considéré supprimé

  // Suivi de l'application et de la connexion
  appInstalled Boolean  @default(false)
  isOnline     Boolean  @default(false)
  lastActive   DateTime?
  lastLogin    DateTime?

  // Authentification à double facteur (2FA)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Rattachement à un cluster (superviseurs et commerciaux)
  clusterId String?
  cluster   Cluster? @relation("ClusterMembers", fields: [clusterId], references: [id], onDelete: SetNull)

  // Cluster dirigé (uniquement pour le superviseur — 1-à-1 inverse)
  managedCluster Cluster? @relation("ClusterSupervisor")

  // Hiérarchie commercial ↔ superviseur
  supervisorId String?
  supervisor   User?   @relation("SupervisorToCommercials", fields: [supervisorId], references: [id], onDelete: SetNull)
  commercials  User[]  @relation("SupervisorToCommercials")

  // Relations métier
  submissions       Submission[]        @relation("CommercialSubmissions")
  validations       Submission[]        @relation("SubmissionValidator")
  validationHistory ValidationHistory[]
  refreshTokens     RefreshToken[]

  @@index([role])
  @@index([clusterId])
  @@index([supervisorId])
  @@index([isActive])
  @@index([status])
  @@index([sponsorCode])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ════════════════════════════════════════════════════════════════════
//  SOUMISSIONS (prospects + marchands)
// ════════════════════════════════════════════════════════════════════

/// Soumission terrain unifiée : un PROSPECT ou un MARCHAND.
///
/// PROSPECT : pas de photos. Identité + statut app + code parrain + GPS.
/// MARCHAND : 3 photos obligatoires (façade, QR code, CNI propriétaire).
model Submission {
  id     String           @id @default(uuid())
  type   SubmissionType
  status SubmissionStatus @default(DRAFT)

  // Auteur (commercial)
  commercialId String
  commercial   User   @relation("CommercialSubmissions", fields: [commercialId], references: [id], onDelete: Restrict)

  // Dénormalisation géographique (recopiés à la création pour KPIs rapides)
  clusterId String?
  communeId String?

  // FK vers la commune de référence
  communeRef Commune? @relation("SubmissionCommune", fields: [communeId], references: [id], onDelete: SetNull)

  // Géolocalisation
  latitude      Float?
  longitude     Float?
  gpsAccuracy   Float?
  gpsCapturedAt DateTime?

  // Localisation textuelle (saisie par le commercial)
  commune     String  // nom de la commune (cohérent avec communeRef.name)
  quartier    String? // texte libre saisi par le commercial
  addressNote String?

  // Champs PROSPECT
  prospectFullName   String?
  prospectPhone      String?
  prospectProfession String?
  prospectGender     String?
  prospectAge        Int?
  appStatus          AppStatus?
  sponsorCode        String? // code parrain du commercial
  observations       String?

  // Champs MARCHAND
  merchantName     String?
  merchantOwner    String?
  merchantPhone    String?
  merchantActivity String?
  merchantRccm     String?

  // Synchronisation offline
  clientUuid     String     @unique
  syncStatus     SyncStatus @default(SYNCED)
  createdOffline Boolean    @default(false)

  // Validation (coordinateur uniquement, 1 seul niveau)
  validatorId       String?
  validator         User?     @relation("SubmissionValidator", fields: [validatorId], references: [id], onDelete: SetNull)
  validatedAt       DateTime?
  validationComment String?
  rejectionReason   String?   // Motif de rejet (obligatoire si REJECTED)

  // Timestamps
  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt

  // Relations
  photos            Photo[]
  validationHistory ValidationHistory[]

  // Index pour KPIs rapides
  @@index([commercialId])
  @@index([clusterId])
  @@index([communeId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([prospectPhone])
  @@index([status, type])
  @@index([validatorId])
  @@map("submissions")
}

// ════════════════════════════════════════════════════════════════════
//  PHOTOS PREUVES (marchands uniquement)
//  Métadonnées Cloudinary uniquement, jamais de binaire en base.
// ════════════════════════════════════════════════════════════════════

model Photo {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  cloudinaryPublicId String
  url                String
  category           PhotoCategory
  width              Int?
  height             Int?
  bytes              Int?
  createdAt          DateTime      @default(now())

  @@index([submissionId])
  @@map("photos")
}

// ════════════════════════════════════════════════════════════════════
//  HISTORIQUE DE VALIDATION (traçabilité / audit / litiges)
// ════════════════════════════════════════════════════════════════════

model ValidationHistory {
  id           String           @id @default(uuid())
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action       ValidationAction
  comment      String?
  createdAt    DateTime         @default(now())

  @@index([submissionId])
  @@index([actorId])
  @@map("validation_history")
}

// ════════════════════════════════════════════════════════════════════
//  CONFIGURATION GLOBALE (paramètres KPI, objectifs, etc.)
// ════════════════════════════════════════════════════════════════════

model Config {
  id    String @id @default("global")
  key   String @unique
  value String
  label String? // Description lisible
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("config")
}
