# ── Base de données (Supabase) ──
#
# IMPORTANT — Pooling : à 100+ commerciaux simultanés, ouvrir une nouvelle
# connexion Postgres par requête sature le pool. Il faut DEUX URLs :
#
#   DATABASE_URL = URL POOLED (port 6543, Supavisor mode "Transaction").
#                  Utilisée au RUNTIME par l'app (adapter PrismaPg). Les
#                  connexions sont multiplexées → tient la charge.
#   DIRECT_URL   = URL DIRECTE (port 5432). Utilisée UNIQUEMENT pour les
#                  migrations Prisma (qui ne passent pas par le pooler).
#
# Où trouver ces URLs : Dashboard Supabase → Settings → Database →
#   - "Connection pooling", mode "Transaction" → DATABASE_URL (6543)
#   - "Connection string" / direct → DIRECT_URL (5432)
#
# En PROD (Render), définir ces 2 variables dans les Environment Variables.

# LOCAL: PostgreSQL local (pas de pooler → une seule URL suffit)
# DATABASE_URL="postgresql://offo_ange:offoange@localhost:5432/commerciale"

# PRODUCTION: Supabase
# Runtime (pooled, port 6543) :
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations (direct, port 5432) :
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.cnqqzuigauknjufqjmby.supabase.co:5432/postgres"

# ── Auth JWT ──
JWT_SECRET="change-moi-en-production"
JWT_REFRESH_SECRET="change-moi-aussi"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── App ──
PORT=3000
FRONTEND_URL="http://localhost:5173"
